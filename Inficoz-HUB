local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Inficoz HUB",
    SubTitle = "by Nes",
    TabWidth = 120,
    Size = UDim2.fromOffset(450, 320),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "Sword" }),
}

-- Buff Gun System
local function ApplyBuffs(Character)
    repeat task.wait() until Character:FindFirstChildOfClass("Tool") or task.wait(1)
    local Weapon = Character:FindFirstChildOfClass("Tool")
    if Weapon then
        Weapon:SetAttribute("spread", 0)
        Weapon:SetAttribute("rateOfFire", 1200)
        Weapon:SetAttribute("reloadTime", 0)
    end
end

local BuffConnection = nil
local BuffEnabled = false

local ToggleBuff = function(state)
    BuffEnabled = state
    if BuffEnabled then
        pcall(function()
            require(game:GetService("ReplicatedStorage").Blaster.Scripts.CameraRecoiler).recoil = function() end
        end)
        ApplyBuffs(game.Players.LocalPlayer.Character)
        BuffConnection = game.Players.LocalPlayer.CharacterAdded:Connect(function(char)
            char:WaitForChild("Humanoid")
            ApplyBuffs(char)
        end)
    else
        if BuffConnection then
            BuffConnection:Disconnect()
            BuffConnection = nil
        end
    end
end

Tabs.Main:AddToggle("BuffToggle", {
    Title = "🔫 Buff Gun (No Recoil / Rapid Fire)",
    Default = false,
    Callback = ToggleBuff
})

-- Noclip System
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Plr = Players.LocalPlayer
local Clipon = false
local NoclipStepped = nil

local ToggleNoclip = function(state)
    Clipon = state
    if Clipon then
        NoclipStepped = RunService.Stepped:Connect(function()
            for _, b in pairs(Workspace:GetChildren()) do
                if b.Name == Plr.Name then
                    for _, v in pairs(b:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end
        end)
    else
        if NoclipStepped then
            NoclipStepped:Disconnect()
            NoclipStepped = nil
        end
    end
end

Tabs.Main:AddToggle("NoclipToggle", {
    Title = "🧱 Noclip",
    Default = false,
    Callback = ToggleNoclip
})

-- Keybind: Press E to enable both Buff Gun and Noclip
local UserInputService = game:GetService("UserInputService")
local guiVisible = true

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.RightControl then
            guiVisible = not guiVisible
            Window:SetVisible(guiVisible)
        elseif input.KeyCode == Enum.KeyCode.E then
            -- Toggle both Buff and Noclip ON
            ToggleBuff(true)
            Fluent.Toggles.BuffToggle:Set(true)
            ToggleNoclip(true)
            Fluent.Toggles.NoclipToggle:Set(true)
        end
    end
end)

